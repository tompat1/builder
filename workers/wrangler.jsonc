{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "builder-knowledge",
  "main": "knowledge.ts",
  "compatibility_date": "2026-10-04",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,https://builder.rynell.app,https://builder.rynell.org",
    "ADMIN_LOGINS": "tompat1"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "builder-accounts",
      "database_id": "135d233d-0a83-44da-9df3-708989296ce5",
      "migrations_dir": "migrations"
    }
  ]
}
