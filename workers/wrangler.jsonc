{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "builder-knowledge",
  "main": "knowledge.ts",
  "compatibility_date": "2026-10-04",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173"
  }
}
