#!/usr/bin/env bash
set -euo pipefail

if [[ -f package.json ]]; then
  node -e '
    const scripts = require("./package.json").scripts || {};
    if (!scripts.preflight) {
      console.error("Missing required npm script: preflight");
      process.exit(1);
    }
  '
  npm run preflight
elif [[ -x scripts/preflight ]]; then
  scripts/preflight
else
  echo "No preflight gate is configured. See directives/testing_and_deployment.md." >&2
  exit 1
fi
